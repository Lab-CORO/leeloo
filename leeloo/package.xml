<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>leeloo</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="guillaume.dupoiron@gmail.com">coro</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>leeloo_calibration</exec_depend>
  <!-- Arbre TF unifié /leeloo : RSP structure + relais topic_tools -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <!-- leeloo.urdf's gripper meshes are package://robotiq_description/meshes/... -->
  <exec_depend>robotiq_description</exec_depend>
  <!-- execute_trajectory's ~/enable_streaming toggle (leeloo pipeline vs direct Doosan API) -->
  <depend>std_srvs</depend>

  <!-- Node Python voxel_dataset_recorder.py (dataset HDF5) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>curobo_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-h5py</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
