<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="leeloo_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Obstacles for the perception -> ESDF path. Without something for the depth
      cameras to see, curobo's voxel map stays empty and collision avoidance is
      not observable at all.

      Placement is in world coordinates with the robot spawned at the origin. For
      reference, in base_link: the arm base (dsr01/world) sits at
      (0.287, 0, 0.706) and the Doosan M1013 reaches ~1.3 m, so obstacles between
      x = 0.8 and x = 1.3 at z = 0.7-1.1 are inside the workspace and inside the
      Kinect's nominal field of view. The pillar is deliberately tall and thin so
      a plan around it is visually unambiguous.
    -->
    <model name="workspace_table">
      <static>true</static>
      <pose>1.15 0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 1.0 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 1.0 0.7</size></box></geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.6 0.45 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_pillar">
      <static>true</static>
      <pose>0.95 0.15 0.95 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.5</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.1 0.1 1</ambient>
            <diffuse>0.8 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box">
      <static>true</static>
      <pose>1.05 -0.3 0.79 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 0.15 0.18</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.18</size></box></geometry>
          <material>
            <ambient>0.1 0.2 0.5 1</ambient>
            <diffuse>0.15 0.35 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
